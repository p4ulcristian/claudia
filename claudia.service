[Unit]
Description=Claudia: chat on the left, Claude's picture on the right
PartOf=graphical-session.target
After=graphical-session.target claudia-runner.service
# Wants, not Requires: restarting the page must not restart the runner (it holds the chats).
Wants=claudia-runner.service

[Service]
WorkingDirectory=%h/Work/tools/claudia
Environment=NODE_ENV=production
# The hub's poke after a push to main lands here; claudia-update.path starts the update.
Environment=CLAUDIA_UPDATE_TRIGGER=%t/claudia-update-requested
ExecStart=%h/.local/bin/bun %h/Work/tools/claudia/server.ts
Restart=on-failure

[Install]
WantedBy=graphical-session.target

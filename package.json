{
  "name": "claudia",
  "version": "2.0.0-beta",
  "private": true,
  "description": "Chat with Claude on the left; Claude explains on the right, in a picture it draws.",
  "scripts": {
    "build": "shadow-cljs release host runner front hub web && npm run build:web-files",
    "build:web-files": "node -e \"const fs=require('fs');if(!fs.existsSync('resources/web/index.html')){console.error('resources/web/index.html is missing: the page has nothing to load');process.exit(1)}fs.cpSync('resources/web','out/web',{recursive:true})\"",
    "watch": "shadow-cljs watch web"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "diff": "8.0.4",
    "libsodium-wrappers": "0.8.4",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "dompurify": "^3.4.17",
    "elkjs": "0.12.1",
    "highlight.js": "11.12.0",
    "marked": "^18.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadow-cljs": "3.5.11"
  }
}

{
  "name": "claudia",
  "version": "2.0.0",
  "private": true,
  "description": "Chat with Claude on the left; Claude explains on the right, in a picture it draws.",
  "scripts": {
    "build": "shadow-cljs release host runner front hub web && npm run build:web-files",
    "build:web-files": "node -e \"const fs=require('fs');if(!fs.existsSync('resources/web/index.html')){console.error('resources/web/index.html is missing: the page has nothing to load');process.exit(1)}fs.cpSync('resources/web','out/web',{recursive:true})\" && node bin/shiki-langs.mjs",
    "watch": "shadow-cljs watch web",
    "test": "shadow-cljs compile test && node out/test.js",
    "ratchet": "node bin/ratchet.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.318",
    "diff": "9.0.0",
    "jose": "6.2.15",
    "libsodium-wrappers": "0.8.4",
    "playwright-core": "1.64.1",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",

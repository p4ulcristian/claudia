[Unit]
Description=claudeXplain: chat on the left, Claude's picture on the right
PartOf=graphical-session.target
After=graphical-session.target

[Service]
WorkingDirectory=%h/Work/tools/claudeXplain
Environment=NODE_ENV=production
ExecStart=%h/.local/bin/bun %h/Work/tools/claudeXplain/server.ts
Restart=on-failure

[Install]
WantedBy=graphical-session.target

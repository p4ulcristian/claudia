# One profile's chats, as that profile's own Linux user (claudia-<profile>). Only the page reaches
# its socket: the runtime folder is the profile's, with an ACL for the page's user.
[Unit]
Description=Claudia runner for profile %i
After=network-online.target
Wants=network-online.target

[Service]
User=claudia-%i
Group=claudia-%i
SupplementaryGroups=claudia-run
EnvironmentFile=/etc/claudia/env
Environment=NODE_ENV=production RUNNER_SOCKET=/run/claudia-%i/runner.sock
WorkingDirectory=/srv/claudia
RuntimeDirectory=claudia-%i
RuntimeDirectoryMode=0710
ExecStartPre=+/usr/bin/setfacl -m u:claudia:x,m::x -m d:u:claudia:rw /run/claudia-%i
ExecStart=/usr/local/bin/bun /srv/claudia/runner.ts
Restart=always
RestartSec=3
# Restarting the runner stops this profile's chats, nothing else.
KillMode=control-group
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
MemoryMax=16G
CPUQuota=800%

[Install]
WantedBy=multi-user.target

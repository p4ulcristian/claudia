# Bring /srv/claudia-beta to the beta branch's newest signed release (deploy/update.sh --shared);
# started by the hub's poke (claudia-beta-update.path) and hourly by the timer.
[Unit]
Description=Claudia beta update from the beta branch's signed release
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The machine's settings: PATH there finds node and cosign (they may live outside /usr/bin).
EnvironmentFile=/etc/claudia-beta/env
Environment=CLAUDIA_UPDATE_TRIGGER=/var/lib/claudia-beta/update-requested
StateDirectory=claudia-beta-update
ExecStart=/bin/bash /srv/claudia-beta/deploy/update.sh --shared

# Claudia beta on a shared server: a profile's runner, as its own Linux user claudia-<profile>.
# Its socket's folder lets the front (user claudia) in and nobody else.
[Unit]
Description=Claudia beta runner for %i
After=claudia-beta-host@%i.service
Wants=claudia-beta-host@%i.service

[Service]
User=claudia-%i
EnvironmentFile=/etc/claudia-beta/env
EnvironmentFile=-/etc/claudia-beta/profile-%i.env
Environment=RUNNER_PROFILE=%i RUNNER_SOCKET=/run/claudia-beta-%i/runner.sock HOST_SOCKET=/run/claudia-beta-host-%i/host.sock
Environment=RUNNER_DATA=/home/claudia-%i/.local/share/claudia-beta CLAUDIA_CWD=/home/claudia-%i/Work
RuntimeDirectory=claudia-beta-%i
RuntimeDirectoryMode=0710
ExecStartPre=+/usr/bin/setfacl -m u:claudia:x,m::x -m d:u:claudia:rw /run/claudia-beta-%i
ExecStart=/usr/bin/env node /srv/claudia-beta/out/runner.js
Restart=always
RestartSec=5
UMask=0002
ProtectSystem=full

[Install]
WantedBy=multi-user.target

# Claudia beta on a shared server: a profile's session host (the Agent SDK sessions), as
# claudia-<profile>. Restarting it stops that profile's running chats; the runner does not.
[Unit]
Description=Claudia beta session host for %i

[Service]
User=claudia-%i
EnvironmentFile=/etc/claudia-beta/env
EnvironmentFile=-/etc/claudia-beta/profile-%i.env
Environment=HOST_SOCKET=/run/claudia-beta-host-%i/host.sock
RuntimeDirectory=claudia-beta-host-%i
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/env node /srv/claudia-beta/out/host.js
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target

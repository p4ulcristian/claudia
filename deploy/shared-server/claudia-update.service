# Bring /srv/claudia to the main branch's newest signed release (deploy/update.sh --shared);
# started by the hub's poke (claudia-update.path) and hourly by the timer.
[Unit]
Description=Claudia update from the main branch's signed release
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The machine's settings: PATH there finds node and cosign (they may live outside /usr/bin).
EnvironmentFile=/etc/claudia/env
Environment=CLAUDIA_UPDATE_TRIGGER=/var/lib/claudia/update-requested
StateDirectory=claudia-update
ExecStart=/bin/bash /srv/claudia/deploy/update.sh --shared

# Bring /srv/claudia up to GitHub's main when it moved (deploy/update.sh); started by the hub's poke
# after a push to main (claudia-update.path) and hourly by the timer.
[Unit]
Description=Claudia update from GitHub main
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=CLAUDIA_UPDATE_TRIGGER=/var/lib/claudia/update-requested
StateDirectory=claudia-update
ExecStart=/bin/bash /srv/claudia/deploy/update.sh

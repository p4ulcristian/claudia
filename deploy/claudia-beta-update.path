# Start claudia-beta-update when the hub pokes this machine's front (POST /api/update-check writes
# CLAUDIA_UPDATE_TRIGGER, which must be this file: set it in ~/.config/claudia-beta/env).
[Unit]
Description=Claudia beta update on the hub's poke

[Path]
PathExists=%t/claudia-beta-update-requested
Unit=claudia-beta-update.service

[Install]
WantedBy=default.target

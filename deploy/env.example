# ~/.config/claudia/env for the claudia-* user units on a single-user machine.
# Every value here is an example: put this machine's own.

# The checkout holding out/host.js, out/runner.js, out/front.js; PATH must find node (22.13+).
CLAUDIA_CHECKOUT=/home/me/claudia
PATH=/home/me/.local/bin:/usr/local/bin:/usr/bin:/bin

# host and runner
HOST_SOCKET=/run/user/1000/claudia-host.sock

# runner
RUNNER_SOCKET=/run/user/1000/claudia-runner.sock
RUNNER_DATA=/home/me/.local/share/claudia
RUNNER_PROFILE=me
CLAUDIA_CWD=/home/me/Work
CLAUDIA_TOKEN_FILE=/home/me/.config/claudia/claude-token
# Optional: 1Password reads on this machine (the vault server) and where this profile's vault is.
CLAUDIA_OP_ACCOUNT=
CLAUDIA_VAULT_SERVER=

# front
FRONT_HOST=127.0.0.1
FRONT_PORT=4540
FRONT_NAME=this-server
# One line per profile: <profile> <email> <runner socket>
FRONT_PROFILES=/home/me/.config/claudia/profiles
# The hub's poke after a push to main writes this file; claudia-update.path watches it
# (%t/claudia-update-requested). CLAUDIA_CHECKOUT must then be a release folder made by
# deploy/update.sh, not a git checkout (a git checkout is never replaced).
CLAUDIA_UPDATE_TRIGGER=/run/user/1000/claudia-update-requested

# Claudia's page on a shared server: the gate's way in, one runner per profile behind it.
# Settings for this server (GATE_HOST, CLAUDIA_NAME, ...) live in /etc/claudia/env, not in the repo.
[Unit]
Description=Claudia page (profiles by sign-in)
After=network-online.target
Wants=network-online.target

[Service]
User=claudia
Group=claudia
EnvironmentFile=/etc/claudia/env
Environment=NODE_ENV=production HOME=/var/lib/claudia-page
# The hub's poke after a push to main lands here; claudia-update.path starts the update.
Environment=CLAUDIA_UPDATE_TRIGGER=/var/lib/claudia/update-requested
WorkingDirectory=/srv/claudia
ExecStart=/usr/local/bin/bun /srv/claudia/server.ts
Restart=always
RestartSec=3
StateDirectory=claudia-page
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/claudia

[Install]
WantedBy=multi-user.target

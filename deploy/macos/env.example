# ~/.config/claudia/env on a Mac (deploy/macos/README.md): read by deploy/macos/run.sh at every
# start of a program, and by install.sh and guard.sh. Same format as Linux's (deploy/env.example):
# KEY=value, no expansion. Every value here is an example: put this Mac's own.

# The release folder deploy/update.sh installs (never a git checkout); PATH must find node, git,
# cosign (Homebrew: /opt/homebrew/bin) and, if used, gh and op.
CLAUDIA_CHECKOUT=/Users/me/claudia
PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin

# host and runner. No /run on macOS: the sockets live in a folder of their own (a socket's path must
# stay under 104 characters).
HOST_SOCKET=/Users/me/.local/state/claudia/host.sock

# runner
RUNNER_SOCKET=/Users/me/.local/state/claudia/runner.sock
RUNNER_DATA=/Users/me/.local/share/claudia
RUNNER_PROFILE=me
CLAUDIA_CWD=/Users/me/Work
CLAUDIA_TOKEN_FILE=/Users/me/.config/claudia/claude-token
# Optional: 1Password reads on this machine (the vault server) and where this profile's vault is.
CLAUDIA_OP_ACCOUNT=
CLAUDIA_VAULT_SERVER=

# front: it listens on this Mac's WireGuard address only (the hub's server entry names it with
# FRONT_PORT). While the tunnel is down it cannot listen; launchd starts it again every 5 s.
FRONT_HOST=192.0.2.2
FRONT_PORT=4540
FRONT_NAME=this-server
# The hub's own tunnel address, where its calls come from: deploy/macos/guard.sh lets FRONT_PORT in
# from there only.
FRONT_HUB_ADDRESS=192.0.2.1
# One line per profile: <profile> <email> <runner socket>
FRONT_PROFILES=/Users/me/.config/claudia/profiles
# The hub's poke writes this file; the claudia.update agent watches it.
CLAUDIA_UPDATE_TRIGGER=/Users/me/.local/state/claudia/update-requested

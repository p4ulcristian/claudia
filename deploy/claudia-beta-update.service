# Bring $CLAUDIA_CHECKOUT (a release folder, not a git checkout) to the beta branch's newest signed
# release (deploy/update.sh); started by the hub's poke (claudia-beta-update.path) and hourly.
[Unit]
Description=Claudia beta update from the beta branch's signed release
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/claudia-beta/env
Environment=CLAUDIA_UPDATE_TRIGGER=%t/claudia-beta-update-requested
ExecStart=/usr/bin/env bash ${CLAUDIA_CHECKOUT}/deploy/update.sh

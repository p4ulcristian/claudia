;; Five builds from one source tree: the master (hub), the slave's three processes (front, runner,
;; host) and the page (web), plus the tests (test/, every namespace ending in -test, run on Node).
;; Node builds run on plain Node (node:sqlite needs 22.13+).
{:source-paths ["src" "test"]
 :dependencies [[reagent/reagent "2.0.1"]
                [re-frame/re-frame "1.4.7"]]
 :builds
 {:host   {:target :node-script :main claudia.slave.host/main   :output-to "out/host.js"}
  :runner {:target :node-script :main claudia.slave.runner/main :output-to "out/runner.js"}
  :front  {:target :node-script :main claudia.slave.front/main  :output-to "out/front.js"}
  :hub    {:target :node-script :main claudia.hub.main/main     :output-to "out/hub.js"}
  :test   {:target :node-test :output-to "out/test.js" :ns-regexp "-test$"}
  :web    {:target :browser
           :output-dir "out/web/js"
           :asset-path "/js"
           :module-loader true
           ;; A dev build loads its files as script tags, not eval (the page's policy forbids eval).
           :devtools {:loader-mode :script}
           ;; Big libraries load on first use: three.js and the 3D view (claudia.web.scene3d), Shiki
           ;; (claudia.web.shiki; its grammars are files of their own, bin/shiki-langs.mjs) and Vega
           ;; (claudia.web.chart). Nothing comes from a CDN (claudia.shared.csp). The prepend is the
           ;; native import() shadow.esm/dynamic-import calls (Closure would rewrite one in the code).
           :modules {:main {:init-fn claudia.web.app/init
                            :prepend "var shadow_esm_import = function (url) { return import(url); };\n"}
                     :scene3d {:entries [claudia.web.scene3d.view] :depends-on #{:main}}
                     :shiki {:entries [claudia.web.shiki.lib] :depends-on #{:main}}
                     :chart {:entries [claudia.web.chart] :depends-on #{:main}}}
           ;; libsodium's and QuickJS's Node paths (fs, crypto) are never taken in a browser.
           ;; three's CommonJS build (the one picked by default) is deprecated and calls
           ;; process.emitWarning, which a browser lacks: three and three-mesh-bvh come as modules.
           :js-options {:resolve {"node:fs" false "crypto" false "fs" false "path" false
                                  "three" {:target :npm :require "three/src/Three.js"}
                                  "three-mesh-bvh" {:target :file :file "node_modules/three-mesh-bvh/build/index.module.js"}}}}}}

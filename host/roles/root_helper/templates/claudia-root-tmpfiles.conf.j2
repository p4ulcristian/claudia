# Claudia's root helper sockets (README decision 52), from host/roles/root_helper; made again at every
# boot. The top folder is open; each agent user's folder only to root and that agent user's own
# group, so a socket inside proves which agent user calls.
d {{ root_socket_dir }} 0755 root root -
{% for user in agent_users %}
d {{ root_socket_dir }}/{{ user }} 0750 root {{ user }} -
{% endfor %}
# System's read socket (README decision 95): only root and the front's group ({{ front_group }}) enter,
# so only the front asks the helper's fixed reads.
d {{ root_read_socket_dir }} 0750 root {{ front_group }} -

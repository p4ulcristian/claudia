{# The no-tap list (README decision 52): one exact command line per line and nothing else, no
   comments, because the root helper reads every line as a command. Generated by
   host/roles/root_helper from group_vars/all.yml and the host's people: every unit with and without
   `.service`, in each of the forms listed there. #}
{% set profiles = people | map(attribute='profile') | list %}
{% set restartable = no_tap_restartable_units
     + (profiles | map('regex_replace', '^(.*)$', 'claudia-runner@\\1.service') | list)
     + (profiles | map('regex_replace', '^(.*)$', 'claudia-host@\\1.service') | list) %}
{% set ns = namespace(lines=[]) %}
{% for unit in restartable %}
{%   for name in [unit, unit | regex_replace('\\.service$', '')] %}
{%     for form in no_tap_restart_forms %}
{%       set ns.lines = ns.lines + [form | replace('UNIT', name)] %}
{%     endfor %}
{%   endfor %}
{% endfor %}
{% for unit in restartable + no_tap_status_only_units %}
{%   for name in [unit, unit | regex_replace('\\.service$', '')] %}
{%     for form in no_tap_status_forms %}
{%       set ns.lines = ns.lines + [form | replace('UNIT', name)] %}
{%     endfor %}
{%     for n in no_tap_journal_lines %}
{%       set ns.lines = ns.lines + ['journalctl -u ' ~ name ~ ' -n ' ~ n,
                                    'journalctl -u ' ~ name ~ ' -n ' ~ n ~ ' --no-pager',
                                    'journalctl -u ' ~ name ~ ' --no-pager -n ' ~ n,
                                    'journalctl --no-pager -u ' ~ name ~ ' -n ' ~ n] %}
{%     endfor %}
{%   endfor %}
{% endfor %}
{% for line in (ns.lines + no_tap_commands) | unique %}
{{ line }}
{% endfor %}

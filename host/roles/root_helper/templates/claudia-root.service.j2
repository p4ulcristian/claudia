# Claudia's root helper (README decision 52). Installed by host/roles/root_helper, never by
# deploy/update.sh: keep this unit out of deploy/shared-server/, whose claudia-*.service files
# install.sh copies on every update. It runs the copy in {{ root_lib_dir }} that this playbook made
# from a built checkout, never /srv/claudia, so Claudia's automatic update cannot change the guard.
# Runs as root and listens on one socket per agent user, {{ root_socket_dir }}/<agent user>/root.sock,
# in a folder only that user's group may enter (tmpfiles.d).
[Unit]
Description=Claudia root helper (runs the agents' sudo commands it may)
After=systemd-tmpfiles-setup.service

[Service]
# Claudia's PATH from /etc/claudia/env, so `node` is found where Claudia's units find it.
Environment=PATH={{ claudia_env_path }}
Environment=ROOT_SOCKET_DIR={{ root_socket_dir }}
Environment=ROOT_NO_TAP={{ root_no_tap_file }}
# The front keeps the person's word (switch, Allow); the helper asks it, never a runner.
Environment=ROOT_FRONT_SOCKET={{ root_front_socket }}
ExecStart=/usr/bin/env node {{ root_lib_dir }}/root.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
